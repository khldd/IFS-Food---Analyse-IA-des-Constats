# Keep secrets and local-only files out of the build context. CI builds from a
# git clone (where these are absent), but local `docker build` would otherwise
# sweep them in via `COPY . .`.
.env
.env.*
gen-lang-client-*.json
*service-account*.json
*-credentials.json
*.pem

# Not needed in the image — reinstalled/regenerated during the build.
node_modules
.next
out
build
coverage

# Repo metadata and tooling.
.git
.gitignore
.claude
*.md
!README.md

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
